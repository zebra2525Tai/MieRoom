// Prisma 7. Connection URLs live in prisma.config.ts (CLI) and lib/server/db.ts (app).
//
// The login tables and the master tables (外部設計書 11章 E02〜E09, E13) exist so far.
// The monitor table (E18) is at the end of this file.
// Better Auth tables follow the shape Better Auth 1.7.14 expects (checked with getAuthTables).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- Better Auth ------------------------------------------------------

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  reservations  Reservation[] @relation("Applicant")
  handled       Reservation[] @relation("Handler")
  roomBlocks    RoomBlock[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ---- Roles (外部設計書 03章, 11章) ---------------------------------------
// E-mails are stored in lower case by the application.

// Who may sign in while APP_ENV=development (and who the S25 screen lists later).
model AllowedEmail {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("allowed_emails")
}

// 時間割管理者 registered on S25. The first admin comes from INITIAL_ADMIN_EMAIL, not from here.
model AdminEmail {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("admin_emails")
}

// E03 講師。メールは、先生の判定に学生の形を使うときは使わない (任意)。
model Teacher {
  id          String   @id @default(uuid()) @db.Uuid
  displayName String   @unique @db.VarChar(20)
  email       String?  @unique @db.VarChar(254)
  tagId       String?  @unique @db.VarChar(64)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjectTeachers SubjectTeacher[]
  lessonTeachers  LessonTeacher[]
  location        Location?

  @@map("teachers")
}

// ---- マスタ (外部設計書 11章 E02〜E09, E13) -------------------------------------
// 名前は無効なものも含めて重複不可 (R5-1)。文字数の上限は 14-1 #11。
// 前後の空白を除くことと、教室名の全角数字→半角は、アプリ (zod) で行う。
// 紐づけ表どうしのつながり (講師の行があるか等) は、保存では止めず、
// 書き出し前の確認 (R5-6) で調べる (R5-5)。そのため紐づけ表の間に外部キーは張らない。

enum RoomKind {
  HOMEROOM // ホームルーム
  FREE // 空き教室

  @@map("room_kind")
}

enum ClosureSource {
  SYSTEM // S23 で入れた
  TOOL // 取込用 CSV の「休み・行事」の行

  @@map("closure_source")
}

// E02 クラス。年度 Y に存在する = startYear <= Y <= endYear (endYear が空なら上限なし) (R5-4)。
model SchoolClass {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique @db.VarChar(30)
  homeRoomId String   @db.Uuid
  startYear  Int
  endYear    Int?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // ホームルーム教室として使われている教室は消せない (R5-7)。
  homeRoom        Room             @relation("HomeRoom", fields: [homeRoomId], references: [id], onDelete: Restrict)
  subjects        ClassSubject[]
  subjectTeachers SubjectTeacher[]
  subjectRooms    SubjectRoom[]
  closures        Closure[]
  lessons         Lesson[]
  monthStatuses   MonthStatus[]

  @@map("classes")
}

// E04 教科
model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(30)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classSubjects   ClassSubject[]
  subjectTeachers SubjectTeacher[]
  subjectRooms    SubjectRoom[]
  lessons         Lesson[]

  @@map("subjects")
}

// E05 教室
model Room {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(20)
  building  String?  @db.VarChar(20) // 棟・階
  kind      RoomKind
  note      String?  @db.VarChar(50)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homeClasses  SchoolClass[] @relation("HomeRoom")
  receivers    Receiver[]
  subjectRooms SubjectRoom[]
  lessons      Lesson[]
  locations    Location[]
  reservations Reservation[]
  blocks       RoomBlock[]

  @@map("rooms")
}

// E06 受信機。1 つの受信機は 1 つの教室。1 つの教室に複数置ける (R7-3)。
model Receiver {
  id         String   @id @default(uuid()) @db.Uuid
  receiverId String   @unique @db.VarChar(64) // IF01 の receiverId
  roomId     String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // 教室を消すと、受信機の登録も消える (R5-7)。
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("receivers")
}

// E07 クラスの教科
model ClassSubject {
  classId   String @db.Uuid
  subjectId String @db.Uuid

  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([classId, subjectId])
  @@map("class_subjects")
}

// E08 教科の講師。teacherId が空 = 「各担当」。
// NULL どうしは一意の索引で重複と見なされないため、teacherKey (講師の ID、または "each") で守る。
// teacherKey はアプリが teacherId ?? "each" で必ず入れる。
model SubjectTeacher {
  classId    String  @db.Uuid
  subjectId  String  @db.Uuid
  teacherId  String? @db.Uuid
  teacherKey String  @db.VarChar(36)

  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher Teacher?    @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@id([classId, subjectId, teacherKey])
  @@map("subject_teachers")
}

// E09 教科の教室。roomId が空 = 「ー」(教室未定)。roomKey は教室の ID、または "none"。
model SubjectRoom {
  classId   String  @db.Uuid
  subjectId String  @db.Uuid
  roomId    String? @db.Uuid
  roomKey   String  @db.VarChar(36)

  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  room    Room?       @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@id([classId, subjectId, roomKey])
  @@map("subject_rooms")
}

// E13 休み・行事。classId が空 = 全校。endDate が空 = 1 日だけ。
// source が TOOL の行は classId と targetMonth (YYYYMM) を持つ (アプリが守る)。
model Closure {
  id          String        @id @default(uuid()) @db.Uuid
  startDate   DateTime      @db.Date
  endDate     DateTime?     @db.Date
  name        String        @db.VarChar(20)
  classId     String?       @db.Uuid
  source      ClosureSource
  targetMonth String?       @db.VarChar(6)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // クラスを消すと、そのクラスの休み・行事も消える (R5-7)。
  class SchoolClass? @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("closures")
}

// ---- 時間割 (外部設計書 11章 E10〜E12, 07章 R3) ---------------------------------------
// 時刻は「0時からの分」の整数 (時限は R3-1 の表)。日付は日付型で、日本時間の日付として扱う。

enum LessonKind {
  FIXED // 教室が決まっている
  ROOM_TBD // 教室未定 (roomName は空)

  @@map("lesson_kind")
}

enum LessonOrigin {
  IMPORT // 取込用 CSV
  EXTRA // 補講 (システムで足した。R3-11)

  @@map("lesson_origin")
}

// E10 授業。取り込んだときの表示名も持つので、マスタを消しても過去の授業は名前で出せる。
// 取込元 (その月のファイル / 前月のファイルの翌月分) は持たない: 月の取り込みの状況 (E12) から、
// 読むときに分かる (R3-7)。変更前の教室・講師の名前と日時は、システムで変更したときだけ入る
// (R3-11。変更した人は残さない)。取り込み (R3-12) で入れ替えると消える。
model Lesson {
  id                   String       @id @default(uuid()) @db.Uuid
  classId              String       @db.Uuid
  date                 DateTime     @db.Date
  startMinutes         Int
  endMinutes           Int
  subjectId            String?      @db.Uuid
  subjectName          String       @db.VarChar(30)
  roomId               String?      @db.Uuid
  roomName             String?      @db.VarChar(20)
  kind                 LessonKind
  origin               LessonOrigin @default(IMPORT)
  cancelled            Boolean      @default(false)
  previousRoomName     String?      @db.VarChar(20)
  previousTeacherNames String?      @db.VarChar(400)
  changedAt            DateTime?
  createdAt            DateTime     @default(now())

  // クラスを消すと過去の授業も消える。教科・教室を消すと、IDだけが空になる (R5-7)。
  class    SchoolClass     @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject  Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  room     Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  teachers LessonTeacher[]

  @@unique([classId, date, startMinutes])
  @@index([date])
  @@map("lessons")
}

// E11 授業の講師。行がなければ「各担当」。講師を消すと、IDだけが空になり、名前は残る。
model LessonTeacher {
  lessonId    String  @db.Uuid
  teacherName String  @db.VarChar(20)
  teacherId   String? @db.Uuid

  lesson  Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@id([lessonId, teacherName])
  @@index([teacherId])
  @@map("lesson_teachers")
}

// E12 取り込みの状況。クラス×対象月。取り込んだ日時だけ持つ (取り込んだ人は残さない)。
// importedAt が空の行は、まだ取り込んでいないが、例外解除 (R3-5) だけしてある。
// 「入力済み」「未定」「仮の時間割だけ」は保存せず、読むときに計算する (R3-7)。
model MonthStatus {
  classId           String    @db.Uuid
  month             String    @db.VarChar(6) // YYYYMM
  lastInputDate     DateTime? @db.Date
  nextLastInputDate DateTime? @db.Date
  importedAt        DateTime?
  exceptionUnlocked Boolean   @default(false) // 1回取り込むと、自動で戻る

  class SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([classId, month])
  @@map("month_status")
}

// ---- 先生の位置 (外部設計書 11章 E17, R7) ------------------------------------------------
// 位置は最新の1件だけ持ち、履歴は持たない (12章)。イベントの表も作らない: 同じイベントの
// 再送は、lastEventId と lastOccurredAt で見分ける (発生時刻が同じか古いイベントは反映しない)。
// 位置の判定はゲートウェイ (校内PC) が行い、システムは確定した状態を受けて保存する。

enum LocationStatus {
  DETECTED // 教室にいる
  UNKNOWN // 最終検出から15秒
  OFFLINE // 最終検出から60秒

  @@map("location_status")
}

model Location {
  teacherId      String         @id @db.Uuid
  roomId         String?        @db.Uuid
  status         LocationStatus
  lastEventId    String         @db.Uuid
  lastOccurredAt DateTime
  updatedAt      DateTime

  // 講師を消すと位置も消える (R5-7)。教室を消すと、教室だけが空になる。
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  room    Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@map("locations")
}

// ---- 予約と使用止め (外部設計書 11章 E14〜E16, R4) ---------------------------------------------
// 期限切れは保存しない: 承認待ちのまま最初の枠が始まったものを、読むときに期限切れとする (R4-6)。
// 予約は、枠の日付から30日たったら消す (R4-11。定期実行は別の段階)。

enum ReservationStatus {
  PENDING // 承認待ち
  APPROVED // 承認済み (代理入力もここ)
  REJECTED // 却下
  CANCELLED // 取消 (承認済みを先生が取り消した)
  WITHDRAWN // 取り下げ (承認前に申請者が)

  @@map("reservation_status")
}

// E14 予約。申請者・対応した先生の氏名は、そのときの名前をコピーして持つ (14-11)。
// 利用者の表を整理(DELETE FROM users)しても、「だれが対応したか」は予約と一緒に残る。
// 申請者の利用者を消すと、その人の予約も消える。対応した先生の利用者を消すと、IDだけが空になる。
// 教室を消すと、予約も一緒に消える (R5-7。使われている教室は消せない)。
model Reservation {
  id            String            @id @default(uuid()) @db.Uuid
  roomId        String            @db.Uuid
  date          DateTime          @db.Date
  purpose       String            @db.VarChar(20)
  note          String            @default("") @db.VarChar(100)
  status        ReservationStatus @default(PENDING)
  proxy         Boolean           @default(false) // 代理入力 (R4-9)
  applicantId   String
  applicantName String            @db.VarChar(100)
  handledById   String?
  handledByName String?           @db.VarChar(100)
  handledAt     DateTime?
  createdAt     DateTime          @default(now())

  room      Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  applicant User              @relation("Applicant", fields: [applicantId], references: [id], onDelete: Cascade)
  handledBy User?             @relation("Handler", fields: [handledById], references: [id], onDelete: SetNull)
  slots     ReservationSlot[]

  @@index([roomId, date])
  @@index([status, date])
  @@index([applicantId, date])
  @@map("reservations")
}

// E15 予約の枠 (1〜8: 1限前半〜4限後半。R3-1)。
model ReservationSlot {
  reservationId String @db.Uuid
  slot          Int    @db.SmallInt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@id([reservationId, slot])
  @@map("reservation_slots")
}

// E16 使用止め。日付と時限の範囲 (前半・後半の両方を止める)。設定した先生の氏名はコピーして持つ。
model RoomBlock {
  id          String   @id @default(uuid()) @db.Uuid
  roomId      String   @db.Uuid
  startDate   DateTime @db.Date
  startPeriod Int      @db.SmallInt
  endDate     DateTime @db.Date
  endPeriod   Int      @db.SmallInt
  setById     String?
  setByName   String   @db.VarChar(100)
  createdAt   DateTime @default(now())

  room  Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  setBy User? @relation(fields: [setById], references: [id], onDelete: SetNull)

  @@index([roomId, endDate])
  @@map("room_blocks")
}

// E18 モニターの合言葉 (S27)。URL に入れて使う (/monitor/<合言葉>)。32文字以上の推測できない値で、
// サーバーが作る。S27 で URL を何度でも見られる仕様なので、ハッシュにせず、そのまま持つ
// (DB の接続情報が漏れたら、合言葉も漏れる。モニターは次の授業と教室の使用状況だけを出す)。
// 無効にした合言葉の URL は「URLが無効です」(S91) になる。
model Monitor {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(20)
  passphrase String   @unique @db.VarChar(64)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("monitors")
}
