# Copy this file to .env.local and fill in the values.
# Never commit real values. Get them from the team lead directly (not via chat).
# Names follow 開発環境まとめ 7章 (draft). Final names are decided in the detailed design.

# DB (Neon). Pooled: used by the app. Unpooled: used by Prisma CLI (npm run db:push).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Login (Better Auth). BETTER_AUTH_SECRET: at least 32 random characters.
# BETTER_AUTH_URL: the address of this deployment, e.g. https://xxx.vercel.app (no trailing slash).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Microsoft sign-in. Only accounts of this tenant whose e-mail domain is listed below get in.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# The tenant the app is registered in.
MICROSOFT_TENANT_ID=
# Optional. Tenant ids whose accounts may sign in (comma separated). When set, the app accepts
# sign-ins from any organization at Microsoft and OUR check lets only these tenants through.
# Needs the app registration to be multi-tenant. Unset: only MICROSOFT_TENANT_ID.
MICROSOFT_ALLOWED_TENANT_IDS=
# Comma separated e-mail domains (no "@"), e.g. example.onmicrosoft.com
ALLOWED_EMAIL_DOMAINS=

# Not used yet: Microsoft is the only sign-in for now.
LOGIN_PROVIDER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# production | development (required). In development only people on the allow list can sign in.
APP_ENV=development
# Enables /_dev/ pages. Never set this in production.
ENABLE_DEV_PAGES=true
# The first 時間割管理者. Always allowed to sign in.
INITIAL_ADMIN_EMAIL=
# Optional. The shape of a student's e-mail before "@", as a pattern (e.g. [0-9]{6} for a six-digit
# student number). A matching address is a student; every other school address is a teacher.
# Admins are never made automatically. Leave empty to let only the teacher list decide.
STUDENT_EMAIL_PATTERN=

# Only for `npm run db:seed` (development database). Comma separated e-mail addresses.
SEED_ALLOWED_EMAILS=
SEED_ADMIN_EMAILS=
SEED_TEACHER_EMAILS=

# The gateway (the school PC) that sends teachers' locations to /api/gateway/location-events.
# GATEWAY_API_KEY: 32 random bytes as 64 hex characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The same value is set on the gateway. Never put it in Git, in a chat or in NEXT_PUBLIC_ variables.
# Both unset: the endpoint answers 403 gateway_disabled.
GATEWAY_API_KEY=
ALLOWED_GATEWAY_ID=
# Production only. Not needed locally.
CRON_SECRET=

# Integration tests (npm run test:integration): the connection string goes in .env.integration,
# NOT in this file or in .env.local. It must be a database whose name ends with _test (or a local
# PostgreSQL): every table is emptied before each test. tests/integration/support/guard.ts refuses
# any other database, and the one the app uses. Never commit it.
# TEST_DATABASE_URL=
