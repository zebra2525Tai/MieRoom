# Copy this file to .env.local and fill in the values.
# Never commit real values. Get them from the team lead directly (not via chat).
# Names follow 開発環境まとめ 7章 (draft). Final names are decided in the detailed design.

# DB (Neon). Pooled: used by the app. Unpooled: used by Prisma CLI.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Login (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# microsoft | google
LOGIN_PROVIDER=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# production | development
APP_ENV=development
# Enables /_dev/ pages. Never set this in production.
ENABLE_DEV_PAGES=true
INITIAL_ADMIN_EMAIL=

SENSOR_API_KEY=
# Production only. Not needed locally.
CRON_SECRET=
